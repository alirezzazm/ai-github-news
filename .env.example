# ---------- General ----------
SITE_NAME=رادار گیت‌هاب
# Public URL (used in RSS and notifications). Set to https://your-domain after DNS/SSL.
SITE_URL=http://62.220.123.88
TIMEZONE=Asia/Tehran
LOG_LEVEL=INFO

# ---------- Postgres (docker-compose) ----------
POSTGRES_DB=aignews
POSTGRES_USER=aignews
POSTGRES_PASSWORD=change-me-strong-password
# Where the web container is published on the host (nginx proxies to it)
WEB_BIND=127.0.0.1
WEB_PORT=4200
# For local dev without Docker you may use SQLite instead:
# DATABASE_URL=sqlite:///./data/dev.db

# ---------- Admin panel ----------
SECRET_KEY=change-me-random-64-chars
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# ---------- GitHub ----------
# Fine-grained PAT, read-only on public repositories. Raises the API limit from 60 to 5000/h
# and enables the GraphQL star tracker. Can also be set later from the admin panel.
GITHUB_TOKEN=
GITHUB_TRENDING_LANGUAGES=,python,typescript,javascript,rust,go,c#,jupyter-notebook
GITHUB_SEARCH_DAYS_NEW=14
GITHUB_SEARCH_MIN_STARS_ACTIVE=1500

# ---------- LLM (all optional; the site works without them, items show "ترجمه نشده") ----------
# Priority / fallback order. Options: anthropic, openai (= any OpenAI-compatible endpoint incl. Ollama).
LLM_PROVIDERS=anthropic,openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low|medium|high - "low" is plenty for translation/summaries and cheapest
ANTHROPIC_EFFORT=low
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Example for a local Ollama (no key needed):
# OPENAI_BASE_URL=http://ollama:11434/v1
# OPENAI_MODEL=qwen2.5:14b

# Cost control
LLM_BATCH_SIZE=4
LLM_DAILY_ITEM_LIMIT=150
LLM_DAILY_TOKEN_LIMIT=2000000
LLM_MIN_PRESCORE=15
LLM_MAX_OUTPUT_TOKENS=6000

# ---------- Notifications (Bale / Telegram) ----------
NOTIFY_PROVIDER=bale
NOTIFY_BOT_TOKEN=
NOTIFY_CHAT_ID=
DIGEST_HOUR=9
DIGEST_ITEMS=10
# Instant alert for items with importance >= N (0 = off)
ALERT_MIN_IMPORTANCE=9

# ---------- Scheduler (minutes) ----------
COLLECT_GITHUB_EVERY_MIN=360
COLLECT_RELEASES_EVERY_MIN=180
COLLECT_HN_EVERY_MIN=120
COLLECT_RSS_EVERY_MIN=120
ENRICH_EVERY_MIN=20
SPIKE_CHECK_EVERY_MIN=360
HN_MIN_POINTS=120
ITEM_RETENTION_DAYS=180

# ---------- Backups ----------
BACKUP_HOUR=3
BACKUP_MINUTE=30
BACKUP_KEEP=7
